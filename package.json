{
  "name": "shiftdrop",
  "productName": "ShiftDrop",
  "version": "1.2.1",
  "description": "Shift basılıyken dosyayı sürükle, anında dönüştür.",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/smoke-test.js",
    "dist": "electron-builder",
    "dist:linux": "node scripts/build.js linux tr",
    "dist:win": "node scripts/build.js win tr",
    "dist:linux:en": "node scripts/build.js linux en",
    "dist:win:en": "node scripts/build.js win en"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.shiftdrop",
    "productName": "ShiftDrop",
    "files": [
      "src/**",
      "assets/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/uiohook-napi/**"
    ],
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Utility",
      "synopsis": "Shift ile sürükle, anında dönüştür"
    },
    "npmRebuild": false,
    "publish": null,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "ShiftDrop",
      "artifactName": "ShiftDrop-Kurulum-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ShiftDrop-Tasinabilir-${version}.${ext}"
    }
  }
}
